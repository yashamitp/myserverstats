# ==============================================================================
# AgentOps Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# NEVER commit production secrets or real API keys to version control.
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=5000

# Client & CORS
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database Configuration
# In development, leave blank or set to 'memory' to use zero-setup embedded MongoDB.
# In production, specify a standard connection string (e.g. mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/agentops
USE_MEMORY_DB=false

# Authentication & Security
# Generate a random 32+ character string for JWT_SECRET (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# AES-256-GCM Credential Encryption Key (Must be 32 bytes / 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY_E_G_NODE_CRYPTO_RANDOMBYTES_32_HEX

# Outbound SSRF Network Policy
# Set to 'true' only in local lab environments (e.g. VirtualBox / VMware 192.168.x.x / 10.x.x.x)
# In public production SaaS, KEEP AS 'false' to strictly block RFC1918 private destinations.
ALLOW_PRIVATE_NETWORKS=false

# Optional Clerk Authentication Provider Integration
# If populated, Clerk JWT session verification is activated alongside standard auth.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# AI Troubleshooting Provider (Optional)
# If unconfigured, the application functions cleanly for ordinary monitoring,
# and displays clear setup guidance when the AI Assistant tab is opened.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_BASE=https://api.openai.com/v1

# Monitoring Engine & Worker
# Background poll interval in seconds
MONITORING_INTERVAL_SEC=10
# Maximum timeout for SSH connection handshakes and command probes in milliseconds
MAX_SSH_TIMEOUT_MS=8000
# Retention window for time-series metrics in days (enforced via MongoDB TTL index)
METRICS_RETENTION_DAYS=30
# Maximum lines to retrieve in journalctl queries
MAX_LOG_LINES=100

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info

# ==============================================================================
# SMTP & EMAIL NOTIFICATIONS
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME="AgentOps 2.0"
